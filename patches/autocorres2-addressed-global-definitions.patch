 val globals_all_addressed = Attrib.setup_config_bool \<^binding>\<open>globals_all_addressed\<close> (K false)
 val populate_globals = Attrib.setup_config_bool \<^binding>\<open>populate_globals\<close> (K false)
 val record_globinits = Attrib.setup_config_bool \<^binding>\<open>record_globinits\<close> (K true)
+val addressed_global_definitions =
+  Attrib.setup_config_string
+    \<^binding>\<open>c_parser_addressed_global_definitions\<close> (K "")
+
+fun parse_addressed_global_definitions spec =
+  let
+    fun parse_entry entry =
+      (case String.fields (fn c => c = #"=") entry of
+        [name, raw_address] =>
+          if name = "" orelse raw_address = "" then
+            error ("Malformed addressed-global definition: " ^ quote entry)
+          else
+            (case Int.fromString raw_address of
+              SOME address =>
+                if address < 0 orelse address > 4294967295 then
+                  error ("Address outside the 32-bit range: " ^ raw_address)
+                else (name, address)
+            | NONE =>
+                error ("Address is not a decimal integer: " ^ raw_address))
+      | _ => error ("Malformed addressed-global definition: " ^ quote entry))
+    fun insert_entry entry table =
+      let val (name, address) = parse_entry entry
+      in
+        if Symtab.defined table name then
+          error ("Duplicate addressed-global definition: " ^ quote name)
+        else Symtab.update (name, address) table
+      end
+  in
+    if spec = "" then Symtab.empty
+    else fold insert_entry (String.fields (fn c => c = #",") spec) Symtab.empty
+  end
